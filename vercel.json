{
  "rewrites": [
    {
      "source": "/api/:match*",
      "destination": "/api/index?__path=/api/:match*"
    },
    {
      "source": "/",
      "destination": "/api/index?__path=/"
    },
    {
      "source": "/index",
      "destination": "/api/index?__path=/"
    },
    {
      "source": "/index.html",
      "destination": "/api/index?__path=/"
    }
  ]
}
